{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "trunkstar": {
      "type": "streamable-http",
      "url": "https://mcp.eu1.trunkstar.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "resource": "https://mcp.eu1.trunkstar.com/mcp",
            "baseScopes": ["trunkstar:read", "trunkstar:write"]
          }
        }
      }
    }
  }
}
